{
  "name": "dsh-sql",
  "version": "0.7.0-local.3",
  "description": "数据源：连接管理、问题驱动的后台会话与持久回填、分批选表和关系确认；保留三个只读 SQL 工具。",
  "type": "module",
  "main": "./index.js",
  "exports": {".": "./index.js", "./client": "./client.js", "./package.json": "./package.json", "./cordis.patch.yml": "./cordis.patch.yml"},
  "files": ["index.js", "runtime.js", "store.js", "flow.js", "host-bridge.js", "vendor/*.js", "client.js", "cordis.patch.yml", "README.md", "CHANGELOG.md", "LICENSE", "THIRD-PARTY-NOTICES.md"],
  "scripts": {"test": "node --test test/*.test.mjs", "check": "node --check index.js && node --check client.js && node --check runtime.js && node --check store.js && node --check flow.js && node --check host-bridge.js"},
  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}, "client": {"platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-connection"]}},
  "engines": {"node": ">=24.0.0", "dsh": ">=0.2.1-rc.5"},
  "dependencies": {"mysql2": "^3.11.0", "pg": "^8.23.0"},
  "license": "MIT",
  "author": "stardustlc; local datasource UI contributors"
}
