{
  "name": "@local/echomind",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "EchoMind 智能会议纪要助手（双轨实时录音、本机离线转写、声纹识别、纪要与待办核对推飞书、音频回放与知识库同步）",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "prompts.js",
    "tool-output.js",
    "workspace-paths.js",
    "config-store.js",
    "credential-store.js",
    "api-client.js",
    "accounts.js",
    "binary-manager.js",
    "capture-manager.js",
    "transcriber-manager.js",
    "audio-importer.js",
    "meeting-store.js",
    "pipeline-runner.js",
    "voiceprints.js",
    "knowledge-sync.js",
    "playback-server.js",
    "remote-service.js",
    "event-projection.js",
    "client.js",
    "runtime-manifest.json",
    "cordis.patch.yml",
    "certs/echomind-ca.pem",
    "lib/minutes-engine.mjs",
    "locale/*.json",
    "icon.svg",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tool-output.test.js credential-store.test.js api-client.test.js accounts.test.js binary-manager.test.js capture-transcriber.test.js playback-server.test.js pipeline-sync.test.js tools.test.js client.test.js skills.test.js",
    "sync:engine": "node build/sync-engine.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": ">=0.2.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.2.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true },
    "@deepseek-ai/dsh-home-paths": { "optional": true }
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
